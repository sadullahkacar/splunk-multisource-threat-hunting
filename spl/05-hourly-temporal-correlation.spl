(index=web sourcetype=access_combined)
OR
(index=security sourcetype=linux_secure "Failed password")
| rex field=_raw "^(?<web_src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| rex field=_raw "from (?<ssh_src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| eval src_ip=coalesce(web_src_ip,ssh_src_ip)
| eval activity_type=if(index="web","HTTP","SSH")
| bin _time span=1h
| stats
    count(eval(activity_type="HTTP")) AS http_requests
    count(eval(activity_type="SSH")) AS ssh_failures
  by _time src_ip
| where http_requests>0 AND ssh_failures>0
| eval correlation_score=http_requests+ssh_failures
| sort - correlation_score
| eval hour=strftime(_time,"%Y-%m-%d %H:%M:%S")
| table hour src_ip http_requests ssh_failures correlation_score
